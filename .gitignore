# =============================================================================
# Evaluation Logs & Outputs
# =============================================================================
evaluation/logs/
*.log
*.out
tensorboard/
wandb/
mlflow/

# experiment_logs: JSONs/figuras diretos de experiment_logs/ são resultados
# pré-publicação (baseline/figuras do Artigo 2) — não versionar. Subpastas
# como archive_smoke_*/ (smoke tests, já rastreados) não são afetadas por
# estes padrões, que não cruzam diretórios.
experiment_logs/*.log
experiment_logs/*.pid
experiment_logs/*.lock
experiment_logs/*.json
experiment_logs/figures/

# experiments/*/logs and experiments/logs: per-run sweep output (F1, epsilon,
# checkpoints) for unpublished articles — never auto-committed, unlike
# experiment_logs/ above which holds already-published baseline results.
experiments/*/logs/
experiments/logs/

