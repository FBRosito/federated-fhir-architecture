# =============================================================================
evaluation/logs/
*.log
*.out
tensorboard/
wandb/
mlflow/

# experiment_logs: ignora logs de texto mas mantém JSONs de resultados no repo
experiment_logs/*.log
experiment_logs/*.pid
experiment_logs/*.lock

