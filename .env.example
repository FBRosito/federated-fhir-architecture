# =============================================================================
# .env.example — copy to .env and fill in your values
# NEVER commit the real .env (already in .gitignore)
# =============================================================================

# ============================================================
# EXPERIMENT PRESETS — uncomment the block for your experiment
# ============================================================

# --- Experiment A: ICD-10 Multi-Label Coding (PubMedBERT-base 110M) ----------
# MODEL_BACKEND=bert
# BERT_BENCHMARK=top50           # top50 | full (Mullenbach 2018)
# FL_BATCH_SIZE=8
# FL_GRADIENT_ACCUM_STEPS=8
# MAX_SEQ_LEN=512

# --- Experiment B: Discharge Summary Generation (Llama-3.2-1B NF4) ----------
# MODEL_BACKEND=llm
# MODEL_NAME=meta-llama/Llama-3.2-1B
# FL_BATCH_SIZE=1
# FL_GRADIENT_ACCUM_STEPS=64
# MAX_SEQ_LEN=1024

# ============================================================
# FL HYPERPARAMETERS
# ============================================================
# FL_STRATEGY=fedprox            # fedprox | fedavg
# FL_NUM_ROUNDS=10               # paper uses 10 cloud rounds; smoke=2
# FL_PROXIMAL_MU=0.01            # FedProx μ (use 0.0 for FedAvg)
# FL_NOISE_MULTIPLIER=0.0        # DP: 0.0=off | 0.5=weak | 1.0=moderate | 2.0=strong
# FL_INITIAL_CLIP_NORM=1.0       # Gradient clipping norm C₀ (fixed after calibration round)
# FL_MIN_CLIENTS=5               # must match number of silos you start
# FL_MAX_EXAMPLES=0              # 0=no limit | 20=smoke/dev
# FL_SEED=42
# ETL_DIRICHLET_ALPHA=0.5        # Non-IID heterogeneity: 0.1 | 0.5 | 1.0

# ============================================================
# LLM-AS-A-JUDGE (post-eval only, Experiment B — discharge summary)
# 3-judge ensemble: Qwen2.5-72B + Gemma-3-27B + DeepSeek-R1 via OpenRouter
# Cost: ~$0.08 per full evaluation (50 samples × 3 judges × ~$0.0005/call)
# Create account + get key: https://openrouter.ai/keys
# ============================================================
# OPENROUTER_API_KEY=sk-or-...

# ============================================================
# COMMUNICATION EFFICIENCY (TurboQuant)
# TurboQuant compresses LoRA deltas during FL transmission — NOT VRAM.
# It is orthogonal to MODEL_BASE_PRECISION (use both independently).
# ============================================================
# FL_LORA_COMPRESS=false         # TurboQuant: false=off | true=~6× bandwidth reduction
# FL_COMPRESS_BITS=4             # TurboQuant bit-width: 2 | 4 | 8 (4 recommended)
# FL_KV_CACHE_BITS=16            # KV cache: 16=none | 1=QJL 1-bit sign quantization (eval only)

# ============================================================
# HARDWARE / PRECISION ABLATION
# ============================================================
# MODEL_BASE_PRECISION=nf4       # nf4 (default, BitsAndBytes 4-bit, ~500 MB) | fp16 | bf16 (~2.4 GB)
# FL_PARALLEL_GPU=false          # false=serialize silos (1 GPU) | true=multi-GPU
# FL_KEEP_MODEL_IN_VRAM=false    # true speeds up dev/smoke runs (keeps model loaded)

# -----------------------------------------------------------------------------
# HuggingFace — required to download Llama-3.2 (gated model)
# Get token: https://huggingface.co/settings/tokens
# Accept terms: https://huggingface.co/meta-llama/Llama-3.2-1B-Instruct
# -----------------------------------------------------------------------------
HF_TOKEN=hf_YOUR_TOKEN_HERE

# -----------------------------------------------------------------------------
# MIMIC-IV — caminhos dos dados no host (montados como /physionet no container)
# Estrutura esperada:
#   ${PHYSIONET_DIR}/mimiciv/3.1/hosp/diagnoses_icd.csv.gz
#   ${PHYSIONET_DIR}/mimiciv/3.1/hosp/d_icd_diagnoses.csv.gz
#   ${PHYSIONET_DIR}/mimic-iv-note/2.2/note/discharge.csv.gz
# -----------------------------------------------------------------------------
PHYSIONET_DIR=/home/SEU_USUARIO/physionet.org/files
MIMIC_HOSP_DIR=/physionet/mimiciv/3.1/hosp
MIMIC_NOTE_DIR=/physionet/mimic-iv-note/2.2/note

# -----------------------------------------------------------------------------
# Hardware — ajuste conforme a GPU disponível
#
# RTX 3060 12 GB (default local):
#   FL_BATCH_SIZE=1
#   FL_GRADIENT_ACCUM_STEPS=64
#   FL_PARALLEL_GPU=false
#
# A100 40 GB (nuvem recomendado):
#   FL_BATCH_SIZE=8
#   FL_GRADIENT_ACCUM_STEPS=8
#   FL_PARALLEL_GPU=true
# -----------------------------------------------------------------------------
FL_BATCH_SIZE=1
FL_GRADIENT_ACCUM_STEPS=64
FL_PARALLEL_GPU=false

# Limite de exemplos para o baseline centralizado (0 = sem limite = pode ser 118k+)
CENTRAL_MAX_EXAMPLES=5000

# -----------------------------------------------------------------------------
# Modelo LLM (Experimento B)
# Opções validadas: meta-llama/Llama-3.2-1B, meta-llama/Llama-3.2-3B-Instruct
# -----------------------------------------------------------------------------
MODEL_NAME=meta-llama/Llama-3.2-1B
